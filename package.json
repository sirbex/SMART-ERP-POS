{
  "name": "samplepos",
  "version": "1.0.0",
  "description": "Enterprise POS System with Accounting",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "test:accounting": "cd SamplePOS.Server && npm run test:accounting",
    "test:integrity": "cd SamplePOS.Server && npm run test:integrity",
    "dev:server": "cd SamplePOS.Server && npm run dev",
    "dev:client": "cd samplepos.client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "lint": "cd SamplePOS.Server && npm run lint && cd ../samplepos.client && npm run lint",
    "lint:fix": "cd SamplePOS.Server && npm run lint:fix && cd ../samplepos.client && npm run lint -- --fix",
    "build": "cd SamplePOS.Server && npm run build:prod && cd ../samplepos.client && npm run build",
    "test": "cd SamplePOS.Server && npm run test && cd ../samplepos.client && npm run test",
    "test:pricing-phases": "node scripts/run-pricing-phase-tests.mjs",
    "test:pricing-phases:live": "node scripts/run-pricing-phase-tests.mjs --live",
    "test:customer-invoice-adjustment:live": "node scripts/test-customer-invoice-adjustment-live.mjs",
    "proof:deploy": "node scripts/proof-deploy-readiness.mjs",
    "proof:corrections": "node scripts/proof-pre-commit-corrections.mjs",
    "proof:at-cost": "cd SamplePOS.Server && npm run proof:at-cost",
    "proof:at-cost:all": "cd SamplePOS.Server && npm run test:pricing-phases && npm run proof:at-cost && cd ../samplepos.client && npm run test:pricing-phases",
    "proof:gr-uom": "cd samplepos.client && npm run proof:gr-uom && cd ../SamplePOS.Server && npm run proof:gr-uom:server",
    "proof:gr-uom:live": "node scripts/proof-gr-uom-live.mjs",
    "proof:adjust-button:bundle": "node scripts/proof-adjust-button-bundle.mjs",
    "proof:adjust-button:live": "node scripts/proof-adjust-button-live.mjs",
    "proof:invoice-adjust-cap": "node scripts/proof-invoice-adjust-cap.mjs",
    "proof:sales-by-cashier": "node scripts/proof-sales-by-cashier.mjs",
    "proof:reorder-po-gr:local": "node scripts/proof-reorder-po-gr-local.mjs",
    "proof:customer-ob:local": "node scripts/proof-customer-opening-balance-local.mjs",
    "proof:ar-allocation:local": "node scripts/proof-ar-allocation-local.mjs",
    "proof:sale-integrity:local": "node scripts/proof-sale-integrity-local.mjs",
    "proof:sale-below-cost:local": "node scripts/proof-sale-below-cost-local.mjs",
    "proof:pos-at-cost-reprice:local": "node scripts/proof-pos-at-cost-reprice-local.mjs",
    "proof:at-cost-fifo-layers:local": "node scripts/proof-at-cost-fifo-layers-local.mjs",
    "proof:at-cost-fifo-split-policy": "node scripts/proof-at-cost-fifo-split-policy.mjs",
    "proof:enterprise-phase-b": "node scripts/proof-enterprise-phase-b.mjs",
    "proof:smart-customer-statement:local": "node scripts/proof-smart-customer-statement-local.mjs",
    "proof:enterprise-phase-c": "node scripts/proof-enterprise-phase-c.mjs",
    "proof:enterprise-phase-d": "node scripts/proof-enterprise-phase-d.mjs",
    "proof:correction-eligibility:local": "node scripts/proof-correction-eligibility-local.mjs",
    "proof:enterprise-phase-f": "node scripts/proof-enterprise-phase-f.mjs",
    "proof:supplier-reassignment:local": "node scripts/proof-supplier-reassignment-local.mjs",
    "proof:supplier-reassignment:e2e": "node scripts/proof-supplier-reassignment-e2e.mjs",
    "proof:return-supplier-flow": "node scripts/proof-return-supplier-flow.mjs",
    "proof:enterprise": "npm run proof:enterprise-phase-b && npm run proof:enterprise-phase-c && npm run proof:enterprise-phase-d && npm run proof:enterprise-phase-f",
    "proof:enterprise:local": "npm run proof:smart-customer-statement:local && npm run proof:correction-eligibility:local && npm run proof:return-supplier-flow && npm run proof:supplier-reassignment:local",
    "local:enterprise": "npm run proof:enterprise && cd SamplePOS.Server && npm run migrate:dry",
    "diagnose:at-cost-fifo:production": "node scripts/diagnose-at-cost-fifo-production.mjs",
    "test:at-cost-regression": "node scripts/run-at-cost-regression.mjs",
    "test:pos-pricing-regression": "node scripts/run-at-cost-regression.mjs",
    "proof:at-cost:local": "node scripts/run-at-cost-regression.mjs --live",
    "proof:pos-pricing:local": "node scripts/run-at-cost-regression.mjs --live",
    "proof:all-tenants": "node scripts/proof-all-tenants-migrations.mjs"
  },
  "devDependencies": {
    "husky": "^8.0.0",
    "lint-staged": "^15.2.0",
    "concurrently": "^8.2.0"
  },
  "lint-staged": {
    "SamplePOS.Server/src/**/*.{ts,js}": [
      "cd SamplePOS.Server && npm run lint --",
      "cd SamplePOS.Server && npm run format --"
    ],
    "samplepos.client/src/**/*.{ts,tsx}": [
      "cd samplepos.client && npm run lint --",
      "cd samplepos.client && npm run format --"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}